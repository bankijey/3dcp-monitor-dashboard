# Copy to .env and fill in for your installation. .env is gitignored.
#
# Equipment addresses and OPC UA node ids are site details, not code. Without them
# the acquisition services print a clear warning and retry; everything else (simulation,
# replay, the recorder, the viewer, the tests) runs without any of this.

# mtec duo-mix connect mixing pump, ECC2100 controller -- OPC UA server
PUMP_OPCUA_URL=opc.tcp://pump-plc.example.lan:4840

# Bosch Rexroth IndraControl XM42 motion/CNC controller -- OPC UA server
GANTRY_OPCUA_URL=opc.tcp://gantry-plc.example.lan:4840

# Micro-Epsilon scanCONTROL laser profile scanner: index into the interfaces the
# LLT SDK enumerates (0 = first). The sensor is found by discovery, not by address.
SCANNER_INTERFACE=0

# OPC UA node ids: which controller variable holds which signal. Write each one as
# the server exposes it, namespace index and identifier, as an OPC UA client shows it.

# Pump controller, read
NODE_PUMP_TORQUE=
NODE_PUMP_WATER_FLOW=
NODE_PUMP_WATER_TEMP=
NODE_PUMP_SOLENOID_VALVE=
NODE_PUMP_WATER_PUMP=
NODE_PUMP_MIXER=

# Pump controller, write (outputs.py)
NODE_PUMP_HEARTBEAT_IN=
NODE_PUMP_HEARTBEAT_OUT=
NODE_PUMP_REMOTE_START=
NODE_PUMP_SPEED_SETPOINT=
NODE_PUMP_WATER_VALVE=

# Motion controller, PLC variables: pressures and temperatures
NODE_GANTRY_P0=
NODE_GANTRY_P1=
NODE_GANTRY_P2=
NODE_GANTRY_P3=
NODE_GANTRY_T0=
NODE_GANTRY_T1=

# Motion controller, write (width_control.py)
NODE_GANTRY_FEED_OVERRIDE=

# Motion controller, NC kernel: axis position and velocity, commanded pump speed
NODE_NC_POS=
NODE_NC_VEL=
NODE_NC_SET_SPEED=

# --- optional: only needed if the defaults clash with something else -------------
# INPUTS_WS_HOST=localhost
# INPUTS_WS_PORT=8001
# SCAN_WS_HOST=localhost
# SCAN_WS_PORT=8764

# Where the viewer and recorder subscribe (defaults derive from the ports above).
# PRINTMON_INPUTS_URL=ws://localhost:8001/full
# PRINTMON_SCAN_URL=ws://localhost:8764/full

# Recorded runs for replay, and the storage root.
# PRINTMON_DATA=data
# PRINTMON_LAKE=lake

# Node-RED legacy endpoint rate cap (frames/s) for the "/" websocket path.
# INPUTS_LEGACY_HZ=100

# Scanner exposure / idle time, units of 10 us. 100 + 600 = 7 ms cycle = 143 Hz.
# Do not go below idle 600 without re-running sweep_idle.py.
# SCAN_EXPOSURE=100
# SCAN_IDLE=600
